# Start the Apache Iceberg REST fixture with `docker compose up -d iceberg-rest`.
ICEBERG_CATALOGS_JSON='[{"id":"local","name":"Local catalog","uri":"http://localhost:8181"}]'

# Optional bearer token environment variable name for a catalog entry.
# Keep the token itself in your shell environment; never put it in this file.
# ICEBERG_LOCAL_TOKEN=replace-me

# Optional Go, Java, Rust, or TypeScript worker endpoints.
# Worker bearer tokens use the same API-environment pattern as catalog tokens.
# ICEBERG_WORKERS_JSON='[{"id":"iceberg-go","name":"Iceberg Go","uri":"http://localhost:8090"}]'
