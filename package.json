{
  "name": "iceberg-control-plane",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --parallel --filter @iceberg-control-plane/api --filter @iceberg-control-plane/web dev",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "lint": "pnpm --recursive --if-present run lint",
    "e2e:iceberg-go": "bash scripts/e2e-iceberg-go.sh",
    "seed:fixture": "dotenv -e .env -- pnpm --filter @iceberg-control-plane/api seed:fixture"
  },
  "devDependencies": {
    "dotenv-cli": "^11.1.0"
  }
}
